# McLarens Transformation Excel Assistant — Backend Environment Variables
# Copy to .env and fill in your values

# ===== REQUIRED =====
GEMINI_API_KEY=
# Get yours at: https://aistudio.google.com/app/apikey

# ===== OPTIONAL =====
OPENROUTER_API_KEY=
# Get yours at: https://openrouter.ai/keys

# ===== CONFIGURATION =====
ALLOWED_ORIGINS=https://localhost:3000,https://your-app.vercel.app
MAX_FILE_SIZE_MB=10
PORT=8000
